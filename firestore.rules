rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isBootstrapAdmin() {
      return isSignedIn() && (
          request.auth.token.email == "admin@au718.com" ||
          request.auth.token.email == "cssjavascript150@gmail.com" ||
        request.auth.uid == "zs7wL0WUSHU9ta5535UAQmFYaAg1"
      );
    }

    function isAdmin() {
      return isSignedIn() && (
        isBootstrapAdmin() ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        exists(/databases/$(database)/documents/admin_roles/$(request.auth.token.email))
      );
    }

    function isFullAdmin() {
      return isSignedIn() && (
        isBootstrapAdmin() ||
        (exists(/databases/$(database)/documents/admins/$(request.auth.uid)) && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'Admin') ||
        (exists(/databases/$(database)/documents/admin_roles/$(request.auth.token.email)) && get(/databases/$(database)/documents/admin_roles/$(request.auth.token.email)).data.role == 'Admin')
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Products
    match /products/{productId} {
      function isValidProduct(data) {
        return data.name is string && data.name.size() <= 200 &&
               data.category is string &&
               data.karat is string &&
               (!('weight' in data) || (data.weight is string && data.weight.size() <= 64)) &&
               data.status in ['published', 'draft'] &&
               data.stock is number;
      }

      // IMPORTANT: each read/list condition is kept as a single, simple
      // statement (either a pure field comparison OR a pure function call).
      // Firestore's query-plan validator can statically prove a query is
      // safe against a SIMPLE condition, but it cannot reliably prove
      // safety for `fieldCheck || functionCall()` combined in one
      // expression — that combination causes `list` queries to be
      // rejected with permission-denied for non-admin callers, even when
      // the underlying query (e.g. where('status','==','published')) is
      // perfectly safe on its own. Splitting the OR into separate `allow`
      // statements fixes this: Firestore tries each statement
      // independently and only needs ONE of them to validate.

      // Public: anyone (including signed-out visitors) can fetch or list
      // published products. This is the branch the storefront's
      // where("status", "==", "published") query relies on.
      allow get, list: if resource.data.status == 'published';

      // Admin: full read access to everything, including drafts.
      allow get, list: if isAdmin();

      allow create: if isAdmin() && isValidId(productId) && isValidProduct(request.resource.data);
      allow update: if isAdmin() && isValidProduct(request.resource.data) &&
                      request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                        'name', 'category', 'karat', 'weight', 'description', 'images', 'stock', 'status', 'updatedAt'
                      ]);
      allow delete: if isAdmin();
    }

    // Categories
    match /categories/{categoryId} {
      allow get, list: if true;
      allow write: if isAdmin();
    }

    // Test Connection
    match /test/connection {
      allow read: if true;
    }

    // Inquiries
    match /inquiries/{inquiryId} {
      function isValidInquiry(data) {
        return data.customerName is string && data.customerName.size() <= 100 &&
               data.customerContact is string && data.customerContact.size() <= 200 &&
               data.message is string && data.message.size() <= 2000 &&
               data.status in ['unread', 'read'] &&
               (!('type' in data) || data.type in ['general', 'consultation']) &&
               (!('serviceRequested' in data) || (data.serviceRequested is string && data.serviceRequested.size() <= 200)) &&
               (!('preferredDate' in data) || (data.preferredDate is string && data.preferredDate.size() <= 100));
      }
      allow create: if isValidInquiry(request.resource.data); 
      allow read, update, delete: if isAdmin();
    }

    // Subscribers (Newsletter)
    match /subscribers/{subscriberId} {
      allow create: if true;
      allow read: if true;
      allow delete: if isAdmin();
    }

    // Newsletters (Campaign Archives)
    match /newsletters/{newsletterId} {
      allow read, write: if isAdmin();
    }

    // Admins & Roles
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isFullAdmin();
    }

    match /admin_roles/{email} {
      allow read: if isSignedIn() && (request.auth.token.email == email || isAdmin());
      allow write: if isFullAdmin();
    }
  }
}
